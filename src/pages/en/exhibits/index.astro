---
import type { Lang } from '../../../i18n/ui';
import { useTranslations } from '../../../i18n/ui';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ExhibitsView from '../../../components/ExhibitsView.astro';

const lang: Lang = 'en';
const path = '/exhibits/';
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  path={path}
  title={`${t('exhibits.title')} · ZX Spectrum — SnC Museum`}
  description="ZX Spectrum exhibits at the Software and Computer Museum: machines from the collection you can see in person in Kharkiv."
>
  <Header lang={lang} active="exhibits" path={path} />
  <ExhibitsView lang={lang} />
  <Footer lang={lang} />
</BaseLayout>
