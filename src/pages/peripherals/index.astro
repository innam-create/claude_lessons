---
import type { Lang } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PeripheralsView from '../../components/PeripheralsView.astro';

const lang: Lang = 'uk';
const path = '/peripherals/';
---

<BaseLayout
  lang={lang}
  path={path}
  title="Периферія · ZX Spectrum — SnC Museum"
  description="Периферія ZX Spectrum: ZX Printer, Interface 1, Microdrive, Interface 2, інтерфейс джойстика Kempston. Освітній проєкт Software and Computer Museum."
>
  <Header lang={lang} active="peripherals" path={path} />
  <PeripheralsView lang={lang} />
  <Footer lang={lang} />
</BaseLayout>
