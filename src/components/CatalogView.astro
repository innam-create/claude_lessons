---
import { getCollection } from 'astro:content';
import type { Lang } from '../i18n/ui';
import { useTranslations, localizePath } from '../i18n/ui';
import { normalizeModels, buildFilterGroups } from '../lib/catalog';
import ModelCard from './ModelCard.astro';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  lang: Lang;
  path: string;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const entries = await getCollection('models');
const models = normalizeModels(entries, lang);
const groups = buildFilterGroups(models, lang);

const homeHref = localizePath('/', lang);

// Компаратор (ТЗ §5.2): до 3 моделей, таблиця відмінностей.
//
// У дизайні панель намальована з двома вже обраними моделями — це була
// демонстрація вигляду, а не стан. Справжній компаратор стартує порожнім
// і панель ховається, поки нічого не обрано.
//
// ТЗ §10 дозволяє localStorage ЛИШЕ для CRT-перемикача й мови, тому вибір
// живе тільки в пам'яті сторінки й скидається при перезавантаженні.
const CMP_MAX = 3;

// Дані для клієнтської таблиці. specs у всіх моделей — однаковий набір рядків
// у однаковому порядку (buildSpecs), тож у таблиці їх можна зіставляти за індексом.
const cmpData = models.map((m) => ({
  slug: m.slug,
  title: m.title,
  href: m.href,
  specs: m.specs.map((s) => ({ label: s.label, value: s.value })),
}));

const cmpI18n = {
  pick: t('compare.pick'),
  picked: t('compare.picked'),
  remove: t('compare.remove'),
  add: t('compare.add'),
  cta: t('compare.cta'),
  unknown: t('detail.unknown'),
  diffMark: t('compare.diffMark'),
  diffOnly: t('compare.diffOnly'),
  noDiff: t('compare.noDiff'),
  max: CMP_MAX,
};

// <: щоб рядок усередині JSON не міг закрити <script> (захист від того,
// щоб дані колись не поламали розмітку).
const toJson = (v: unknown) => JSON.stringify(v).replace(/</g, '\\u003c');
---

<main>
  <div class="wrap">
    <Breadcrumbs
      items={[{ label: t('nav.home'), href: homeHref }, { label: t('catalog.title') }]}
    />

    <div class="title-row">
      <h1>{t('catalog.title')}</h1>
      <div
        class="count"
        id="catalog-count"
        data-total={models.length}
        data-suffix={t('catalog.count.suffix')}
        data-of={t('catalog.count.of')}
      >
        {models.length} {t('catalog.count.suffix')}
      </div>
    </div>
  </div>

  <div class="wrap layout">
    <!-- ФІЛЬТРИ -->
    <aside class="filters" aria-label={t('catalog.filters')}>
      <div class="filters-head">
        <span class="mini-bar" aria-hidden="true">
          <span style="background:#ff0000"></span>
          <span style="background:#ffff00"></span>
          <span style="background:#00ff00"></span>
        </span>
        {t('catalog.filters')}
      </div>

      {
        groups.map((g) => (
          <div class="group">
            <div class="group-label">{g.label}</div>
            <div class="chips">
              {g.chips.map((c) => (
                <button
                  type="button"
                  class="chip"
                  data-group={g.key}
                  data-value={c.value}
                  aria-pressed="false"
                >
                  {c.label}
                </button>
              ))}
            </div>
          </div>
        ))
      }

      <button type="button" class="reset js-reset">{t('catalog.reset')}</button>
    </aside>

    <!-- РЕЗУЛЬТАТИ -->
    <div class="results">
      <div class="grid" id="catalog-grid">
        {models.map((m) => <ModelCard model={m} lang={lang} />)}
      </div>

      <!-- стан «нічого не знайдено» -->
      <div class="empty" id="catalog-empty" hidden>
        <div class="empty-dots" aria-hidden="true">
          <span style="background:#ff0000"></span><span style="background:#1c1c1c"></span>
          <span style="background:#ffff00"></span><span style="background:#1c1c1c"></span>
          <span style="background:#1c1c1c"></span><span style="background:#00ff00"></span>
          <span style="background:#1c1c1c"></span><span style="background:#00ffff"></span>
        </div>
        <div class="empty-title">{t('catalog.empty.title')}</div>
        <p class="empty-body">{t('catalog.empty.body')}</p>
        <button type="button" class="empty-reset js-reset">{t('catalog.reset')}</button>
      </div>
    </div>
  </div>

  <!-- КОМПАРАТОР -->
  <div class="comparator" id="comparator" hidden>
    <div class="wrap cmp-inner">
      <span class="cmp-title">{t('compare.title')}</span>
      <div class="cmp-slots" id="cmp-slots"></div>
      <button type="button" class="cmp-clear" id="cmp-clear">{t('compare.clear')}</button>
      <button type="button" class="cmp-cta" id="cmp-cta" disabled>
        {t('compare.cta')} (0/{CMP_MAX})
      </button>
    </div>
  </div>

  {/*
    Таблиці відмінностей у дизайні немає — ТЗ §5.2 її вимагає, макет не малює.
    Зроблено словником дизайн-системи: маджента компаратора, моно-шрифт, нульові
    кути, рамки замість тіней. <dialog> — щоб не заводити окремий маршрут
    (у структурі ТЗ §5 сторінки /compare/ немає) і отримати Esc та фокус нативно.
  */}
  <dialog class="cmp-dialog" id="cmp-dialog" aria-labelledby="cmp-dialog-title">
    <div class="cmp-dialog-head">
      <h2 id="cmp-dialog-title">{t('compare.dialogTitle')}</h2>
      <div class="cmp-head-tools">
        {/*
          «Лише відмінності» (ТЗ §5.2): ховає рядки, де відомі значення збігаються,
          і неповні рядки (частина значень невідома — не стверджувана відмінність).
          checkbox, а не кнопка: це двостанний фільтр, і aria-checked дає його стан
          зчитувачам екрана без додаткового тексту.
        */}
        <label class="cmp-difftoggle">
          <input type="checkbox" id="cmp-diffonly" />
          <span>{t('compare.diffOnly')}</span>
        </label>
        <button type="button" class="cmp-close" id="cmp-close" aria-label={t('compare.close')}>
          ×
        </button>
      </div>
    </div>
    <div class="cmp-table-wrap" id="cmp-table-wrap"></div>
  </dialog>

  <script type="application/json" id="cmp-data" is:inline set:html={toJson(cmpData)} />
  <script type="application/json" id="cmp-i18n" is:inline set:html={toJson(cmpI18n)} />
</main>

<style>
  .wrap {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 28px;
  }

  .title-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding: 18px 0 8px;
    border-bottom: 1px solid var(--hair);
  }
  h1 {
    font-family: var(--font-pixel);
    font-weight: 700;
    font-size: 44px;
    color: var(--zx-white);
    text-transform: uppercase;
    margin: 0;
    line-height: 1;
  }
  .count {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-dim);
  }

  .layout {
    display: flex;
    gap: 28px;
    align-items: flex-start;
    flex-wrap: wrap;
    padding-top: 26px;
    padding-bottom: 60px;
  }

  /* --- фільтри --- */
  .filters {
    flex: 0 0 240px;
    width: 240px;
    border: 2px solid var(--border);
    padding: 22px;
    box-sizing: border-box;
    position: sticky;
    top: 16px;
  }
  .filters-head {
    font-family: var(--font-pixel);
    font-size: 16px;
    color: var(--zx-white);
    text-transform: uppercase;
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .mini-bar { display: inline-flex; gap: 3px; }
  .mini-bar > span { width: 5px; height: 14px; }

  .group { margin-bottom: 22px; }
  .group-label {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-dim);
    margin-bottom: 11px;
  }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 6px 11px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    cursor: pointer;
    border: 1px solid var(--border-2);
    color: var(--text-dim);
    background: transparent;
    transition:
      border-color var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out);
  }
  .chip:hover { color: var(--zx-white); }
  .chip.on {
    border-color: var(--zx-cyan);
    color: var(--zx-cyan);
    background: rgba(0, 255, 255, 0.08);
  }

  .reset {
    width: 100%;
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: transparent;
    color: var(--text-dim);
    border: 1px solid var(--border-2);
    padding: 10px;
    cursor: pointer;
    margin-top: 4px;
  }
  .reset:hover { color: var(--zx-white); border-color: var(--text-dim); }

  /* --- результати --- */
  /* min-width тримає дві колонки на десктопі, але на 320px (нижня межа ТЗ §10)
     доступно лише ~264px — тому нижче він знімається в медіазапиті 768px. */
  .results { flex: 1 1 560px; min-width: 280px; }
  /* minmax(0,1fr), а не 1fr: «1fr» = «minmax(auto,1fr)», а auto-мінімум дорівнює
     min-content колонки. Рядок ліцензії в картці має white-space:nowrap, тож його
     min-content — це вся довжина тексту (~338px). Через це колонка розпирала
     контейнер зсередини й давала горизонтальний скрол на 320px (ТЗ §10).
     З мінімумом 0 колонка стискається, а рядок обрізається трикрапкою, як і задумано. */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .empty {
    border: 2px dashed var(--border);
    padding: 56px 28px;
    text-align: center;
  }
  .empty-dots {
    display: inline-grid;
    grid-template-columns: repeat(4, 12px);
    gap: 4px;
    margin-bottom: 22px;
  }
  .empty-dots > span { width: 12px; height: 12px; }
  .empty-title {
    font-family: var(--font-pixel);
    font-size: 24px;
    color: var(--zx-white);
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .empty-body {
    font-size: 16px;
    color: var(--text-dim);
    line-height: 1.6;
    max-width: 420px;
    margin: 0 auto 22px;
  }
  .empty-reset {
    font-family: var(--font-mono);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: var(--zx-yellow);
    color: #000;
    border: none;
    padding: 12px 22px;
    cursor: pointer;
  }

  /* --- компаратор --- */
  .comparator {
    position: sticky;
    bottom: 0;
    background: var(--surface);
    border-top: 2px solid var(--zx-magenta);
    z-index: 10;
  }
  .comparator[hidden] { display: none; }
  .cmp-inner {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: 14px;
    padding-bottom: 14px;
  }
  .cmp-title {
    font-family: var(--font-pixel);
    font-size: 15px;
    color: var(--zx-magenta);
    text-transform: uppercase;
    flex: none;
  }
  .cmp-slots {
    display: flex;
    gap: 8px;
    flex: 1 1 auto;
    flex-wrap: wrap;
  }
  .cmp-chip {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 6px 11px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .cmp-chip.filled {
    border: 1px solid var(--zx-magenta);
    color: var(--zx-white);
    background: rgba(255, 0, 255, 0.08);
  }
  .cmp-chip.empty {
    border: 1px dashed var(--dim-4);
    color: var(--dim-6);
  }
  .cmp-remove {
    background: none;
    border: none;
    color: var(--zx-magenta);
    cursor: pointer;
    font-weight: 700;
    font-family: inherit;
    font-size: inherit;
    padding: 0 0 0 2px;
  }
  .cmp-cta {
    font-family: var(--font-pixel);
    font-size: 14px;
    text-transform: uppercase;
    background: var(--zx-magenta);
    color: #000;
    border: none;
    padding: 11px 20px;
    cursor: pointer;
    flex: none;
  }
  .cmp-cta:disabled { opacity: 0.5; cursor: not-allowed; }
  .cmp-clear {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: transparent;
    color: var(--text-dim);
    border: 1px solid var(--border-2);
    padding: 9px 12px;
    cursor: pointer;
    flex: none;
  }
  .cmp-clear:hover { color: var(--zx-white); border-color: var(--text-dim); }

  /* --- таблиця відмінностей (у дизайні відсутня, ТЗ §5.2) --- */
  .cmp-dialog {
    border: 2px solid var(--zx-magenta);
    background: var(--bg);
    color: var(--text);
    padding: 0;
    max-width: min(920px, calc(100vw - 32px));
    width: 100%;
    max-height: calc(100vh - 64px);
    box-sizing: border-box;
  }
  .cmp-dialog::backdrop { background: rgba(0, 0, 0, 0.75); }
  .cmp-dialog-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--hair);
  }
  .cmp-dialog-head h2 {
    font-family: var(--font-pixel);
    font-size: 20px;
    color: var(--zx-magenta);
    text-transform: uppercase;
    margin: 0;
  }
  .cmp-close {
    background: none;
    border: 1px solid var(--border-2);
    color: var(--text-dim);
    font-size: 20px;
    line-height: 1;
    padding: 4px 11px;
    cursor: pointer;
    flex: none;
  }
  .cmp-close:hover { color: var(--zx-white); border-color: var(--text-dim); }

  .cmp-head-tools {
    display: flex;
    align-items: center;
    gap: 14px;
    flex: none;
  }
  /* Тумблер «лише відмінності». Обведення — рамкою (елевація без тіней, §4).
     Активний стан підсвічується маджентою — колір компаратора — але поряд
     завжди є підпис-текст, тож колір не єдиний носій сенсу (ТЗ §4.2). */
  .cmp-difftoggle {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-dim);
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
  }
  .cmp-difftoggle input {
    appearance: none;
    -webkit-appearance: none;
    width: 15px;
    height: 15px;
    margin: 0;
    border: 1px solid var(--border-2);
    background: transparent;
    cursor: pointer;
    flex: none;
    position: relative;
  }
  .cmp-difftoggle input:checked {
    border-color: var(--zx-magenta);
    background: rgba(255, 0, 255, 0.12);
  }
  .cmp-difftoggle input:checked::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 5px;
    width: 3px;
    height: 7px;
    border: solid var(--zx-magenta);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  .cmp-difftoggle input:focus-visible {
    outline: 2px solid var(--zx-cyan);
    outline-offset: 2px;
  }
  .cmp-difftoggle:has(input:checked) { color: var(--zx-white); }

  /* Таблицю будує JS, тому scoped-CSS Astro до неї не доходить: скоуп працює
     через data-атрибут, який ставиться лише елементам із шаблону. Звідси
     :global() — селектори прив'язані до .cmp-table-wrap, тож глобально нічого
     не тече. Без цього таблиця рендерилась зовсім без стилів, а .sr-only
     показував службовий текст «(відрізняється)» просто на сторінці. */
  .cmp-dialog[open] {
    display: flex;
    flex-direction: column;
  }
  /* Вузькі екрани: таблиця гортається всередині діалогу, а не розпирає сторінку. */
  .cmp-table-wrap {
    overflow: auto;
    padding: 20px;
  }
  .cmp-table-wrap :global(.cmp-table) {
    border-collapse: collapse;
    width: 100%;
    min-width: 380px;
  }
  .cmp-table-wrap :global(th),
  .cmp-table-wrap :global(td) {
    text-align: left;
    padding: 11px 14px;
    vertical-align: baseline;
    border-bottom: 1px solid var(--hair);
  }
  .cmp-table-wrap :global(thead th) {
    font-family: var(--font-pixel);
    font-size: 15px;
    color: var(--zx-white);
    text-transform: uppercase;
    border-bottom: 2px solid var(--border);
  }
  .cmp-table-wrap :global(thead th a) { color: inherit; text-decoration: none; }
  .cmp-table-wrap :global(thead th a:hover) { color: var(--zx-cyan); }
  .cmp-table-wrap :global(tbody th) {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-dim);
    font-weight: 400;
    white-space: nowrap;
  }
  .cmp-table-wrap :global(td) {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text);
  }
  .cmp-table-wrap :global(td.unknown) {
    font-family: var(--font-body);
    font-style: italic;
    color: var(--dim-6);
  }
  /* Рядок із відмінністю. Колір — НЕ єдиний носій сенсу (ТЗ §4.2): поряд стоїть
     знак «≠», а для зчитувачів екрана — текст у .sr-only. */
  .cmp-table-wrap :global(tr.diff th) { color: var(--zx-magenta); }
  .cmp-table-wrap :global(tr.diff) { background: rgba(255, 0, 255, 0.06); }
  .cmp-table-wrap :global(.mark) {
    margin-left: 6px;
    font-weight: 700;
    color: var(--zx-magenta);
  }
  /* .partial — рядок, де частина значень невідома: не «≠» і не «збігається».
     Жодного акценту: стверджувати тут нічого не можна, клітинка сама каже
     «невідомо». */
  .cmp-table-wrap :global(.sr-only) {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* «Лише відмінності»: ховаємо збіги й неповні рядки, лишаючи тільки tr.diff. */
  .cmp-table-wrap.diff-only :global(tr.same),
  .cmp-table-wrap.diff-only :global(tr.partial) {
    display: none;
  }
  /* Чесний порожній стан, коли відмінностей немає (показується лише в diff-only). */
  .cmp-table-wrap :global(.cmp-nodiff) {
    display: none;
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-dim);
    padding: 18px 2px 0;
    max-width: 520px;
  }
  .cmp-table-wrap.diff-only.no-diff :global(.cmp-nodiff) { display: block; }
  /* Коли відмінностей немає, порожню таблицю (лише шапка) ховаємо. */
  .cmp-table-wrap.diff-only.no-diff :global(.cmp-table) { display: none; }

  /* --- адаптивність (ТЗ: каталог 1/2/3/4 колонки) --- */
  @media (max-width: 1024px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 768px) {
    .filters {
      flex: 1 1 100%;
      width: 100%;
      position: static;
      padding: 20px;
    }
    .results { min-width: 0; }
    .grid { grid-template-columns: minmax(0, 1fr); }
    h1 { font-size: 34px; }
  }
  @media (max-width: 400px) {
    .wrap { padding: 0 16px; }
    h1 { font-size: 28px; }
  }
  @media (min-width: 1440px) {
    .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>

<script>
  // Острівна логіка фільтрів каталогу (ТЗ §5.2): клієнтська, без перезавантаження.
  const grid = document.getElementById('catalog-grid');
  const countEl = document.getElementById('catalog-count');
  const emptyEl = document.getElementById('catalog-empty');
  const comparator = document.getElementById('comparator');

  if (grid && countEl && emptyEl) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-card]'));
    const chips = Array.from(document.querySelectorAll<HTMLElement>('.chip'));
    const total = cards.length;
    const suffix = countEl.dataset.suffix ?? '';
    const ofWord = countEl.dataset.of ?? '';

    // group -> Set(active values)
    const selected: Record<string, Set<string>> = {};

    function cardPasses(card: HTMLElement): boolean {
      return Object.entries(selected).every(([group, set]) => {
        if (set.size === 0) return true;
        if (group === 'avail') return card.dataset.museum === 'true';
        const val = card.dataset[group] ?? '';
        return set.has(val);
      });
    }

    function apply() {
      let visible = 0;
      for (const card of cards) {
        const ok = cardPasses(card);
        card.style.display = ok ? '' : 'none';
        if (ok) visible++;
      }
      const anySel = Object.values(selected).some((s) => s.size > 0);
      countEl!.textContent = anySel
        ? `${visible} ${ofWord} ${total} ${suffix}`
        : `${total} ${suffix}`;

      const isEmpty = visible === 0;
      emptyEl!.hidden = !isEmpty;
      grid!.hidden = isEmpty;
      // Видимість компаратора більше не залежить від фільтрів — нею керує
      // наявність вибору (див. render() нижче). Обране не скидається, коли
      // модель ховає фільтр: інакше фільтрування мовчки ламало б порівняння.
    }

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const g = chip.dataset.group!;
        const v = chip.dataset.value!;
        if (!selected[g]) selected[g] = new Set();
        const set = selected[g];
        if (set.has(v)) {
          set.delete(v);
          chip.classList.remove('on');
          chip.setAttribute('aria-pressed', 'false');
        } else {
          set.add(v);
          chip.classList.add('on');
          chip.setAttribute('aria-pressed', 'true');
        }
        apply();
      });
    }

    for (const btn of Array.from(document.querySelectorAll('.js-reset'))) {
      btn.addEventListener('click', () => {
        for (const k in selected) selected[k].clear();
        for (const chip of chips) {
          chip.classList.remove('on');
          chip.setAttribute('aria-pressed', 'false');
        }
        apply();
      });
    }
  }

  // --- Компаратор (ТЗ §5.2): до 3 моделей + таблиця відмінностей ---
  //
  // Вибір тримається в пам'яті: ТЗ §10 дозволяє localStorage лише для CRT і мови,
  // тож зберігати його між перезавантаженнями свідомо не можна.
  type CmpSpec = { label: string; value: string | null };
  type CmpModel = { slug: string; title: string; href: string; specs: CmpSpec[] };

  const dataEl = document.getElementById('cmp-data');
  const i18nEl = document.getElementById('cmp-i18n');
  const slotsEl = document.getElementById('cmp-slots');
  const ctaEl = document.getElementById('cmp-cta') as HTMLButtonElement | null;
  const clearEl = document.getElementById('cmp-clear');
  const dialogEl = document.getElementById('cmp-dialog') as HTMLDialogElement | null;
  const closeEl = document.getElementById('cmp-close');
  const tableWrap = document.getElementById('cmp-table-wrap');
  const diffOnlyEl = document.getElementById('cmp-diffonly') as HTMLInputElement | null;

  if (dataEl && i18nEl && comparator && slotsEl && ctaEl && dialogEl && tableWrap) {
    const models: CmpModel[] = JSON.parse(dataEl.textContent || '[]');
    const t = JSON.parse(i18nEl.textContent || '{}');
    const MAX: number = t.max ?? 3;
    const byId = new Map(models.map((m) => [m.slug, m]));

    // Порядок = порядок додавання, щоб колонки не стрибали.
    const picked: string[] = [];

    const addBtns = Array.from(
      document.querySelectorAll<HTMLButtonElement>('[data-cmp-add]'),
    );

    function render() {
      // 1. Панель: чипси обраних + порожній слот-підказка, поки є місце.
      slotsEl!.textContent = '';
      for (const slug of picked) {
        const m = byId.get(slug)!;
        const chip = document.createElement('span');
        chip.className = 'cmp-chip filled';
        chip.append(m.title);
        const x = document.createElement('button');
        x.type = 'button';
        x.className = 'cmp-remove';
        x.setAttribute('aria-label', `${t.remove}: ${m.title}`);
        x.textContent = '×';
        x.addEventListener('click', () => toggle(slug));
        chip.append(x);
        slotsEl!.append(chip);
      }
      if (picked.length < MAX) {
        const empty = document.createElement('span');
        empty.className = 'cmp-chip empty';
        empty.textContent = t.add;
        slotsEl!.append(empty);
      }

      // 2. Панель ховається, поки нічого не обрано.
      comparator!.hidden = picked.length === 0;

      // 3. Кнопка: порівнювати можна від двох моделей.
      ctaEl!.textContent = `${t.cta} (${picked.length}/${MAX})`;
      ctaEl!.disabled = picked.length < 2;

      // 4. Кнопки на картках: стан + блокування решти на ліміті.
      const full = picked.length >= MAX;
      for (const btn of addBtns) {
        const card = btn.closest<HTMLElement>('[data-card]')!;
        const on = picked.includes(card.dataset.slug!);
        btn.setAttribute('aria-pressed', String(on));
        btn.textContent = on ? btn.dataset.picked! : btn.dataset.pick!;
        card.classList.toggle('picked', on);
        btn.disabled = full && !on;
      }
    }

    function toggle(slug: string) {
      const i = picked.indexOf(slug);
      if (i >= 0) picked.splice(i, 1);
      else if (picked.length < MAX) picked.push(slug);
      render();
    }

    for (const btn of addBtns) {
      btn.addEventListener('click', () => {
        const card = btn.closest<HTMLElement>('[data-card]');
        if (card?.dataset.slug) toggle(card.dataset.slug);
      });
    }

    clearEl?.addEventListener('click', () => {
      picked.length = 0;
      render();
    });

    // Синхронізує режим «лише відмінності» з чекбоксом: клас на обгортці керує
    // видимістю рядків (CSS). Викликається при зміні чекбокса й при кожній збірці.
    function syncDiffOnly() {
      tableWrap!.classList.toggle('diff-only', !!diffOnlyEl?.checked);
    }
    diffOnlyEl?.addEventListener('change', syncDiffOnly);

    // --- Таблиця відмінностей ---
    function buildTable() {
      const chosen = picked.map((s) => byId.get(s)!);
      const table = document.createElement('table');
      table.className = 'cmp-table';

      const thead = document.createElement('thead');
      const hr = document.createElement('tr');
      hr.append(document.createElement('td')); // порожній кут
      for (const m of chosen) {
        const th = document.createElement('th');
        th.scope = 'col';
        const a = document.createElement('a');
        a.href = m.href;
        a.textContent = m.title;
        th.append(a);
        hr.append(th);
      }
      thead.append(hr);
      table.append(thead);

      const tbody = document.createElement('tbody');
      let diffRows = 0;
      // Набір рядків у всіх моделей однаковий (buildSpecs) — зіставляємо за індексом.
      chosen[0].specs.forEach((row, i) => {
        const values = chosen.map((m) => m.specs[i].value);

        // Відмінність рахується ЛИШЕ серед відомих значень. «Невідомо» — це не
        // відмінність: якщо в однієї моделі поле порожнє, ми не знаємо, чи воно
        // інше, і не маємо права це стверджувати. Тож «Мембранна · Мембранна ·
        // невідомо» — не «≠», а неповний рядок. Якщо ж відомі значення вже
        // різняться, невідоме цього не скасовує.
        const known = values.filter((v): v is string => v !== null);
        const differs = new Set(known).size > 1;
        const incomplete = known.length !== values.length;

        const tr = document.createElement('tr');
        tr.className = differs ? 'diff' : incomplete ? 'partial' : 'same';
        if (differs) diffRows++;

        const th = document.createElement('th');
        th.scope = 'row';
        th.append(row.label);
        if (differs) {
          // ТЗ §4.2: колір не єдиний носій сенсу — поряд із маджентою є знак «≠»
          // і текст для зчитувачів екрана.
          const mark = document.createElement('span');
          mark.className = 'mark';
          mark.setAttribute('aria-hidden', 'true');
          mark.textContent = '≠';
          const sr = document.createElement('span');
          sr.className = 'sr-only';
          sr.textContent = ` (${t.diffMark})`;
          th.append(mark, sr);
        }
        tr.append(th);

        for (const v of values) {
          const td = document.createElement('td');
          if (v === null) {
            td.className = 'unknown';
            td.textContent = t.unknown;
          } else {
            td.textContent = v;
          }
          tr.append(td);
        }
        tbody.append(tr);
      });
      table.append(tbody);

      // Чесний порожній стан для режиму «лише відмінності»: якщо жодного tr.diff,
      // нема чого показувати — виводимо пояснення замість порожньої таблиці.
      const note = document.createElement('p');
      note.className = 'cmp-nodiff';
      note.textContent = t.noDiff;

      tableWrap!.textContent = '';
      tableWrap!.classList.toggle('no-diff', diffRows === 0);
      tableWrap!.append(table, note);
      syncDiffOnly();
    }

    ctaEl.addEventListener('click', () => {
      if (picked.length < 2) return;
      buildTable();
      dialogEl.showModal();
    });
    closeEl?.addEventListener('click', () => dialogEl.close());

    render();
  }
</script>
