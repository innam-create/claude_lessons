---
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ExhibitsView from '../../components/ExhibitsView.astro';

const lang: Lang = 'uk';
const path = '/exhibits/';
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  path={path}
  title={`${t('exhibits.title')} · ZX Spectrum — SnC Museum`}
  description="Експонати ZX Spectrum у Software and Computer Museum: машини з колекції, які можна побачити наживо в Харкові."
>
  <Header lang={lang} active="exhibits" path={path} />
  <ExhibitsView lang={lang} />
  <Footer lang={lang} />
</BaseLayout>
