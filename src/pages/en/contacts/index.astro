---
import type { Lang } from '../../../i18n/ui';
import { useTranslations } from '../../../i18n/ui';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ContactsView from '../../../components/ContactsView.astro';

const lang: Lang = 'en';
const path = '/contacts/';
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  path={path}
  title={`${t('contacts.title')} · ZX Spectrum — SnC Museum`}
  description="How to visit the Software and Computer Museum in Kharkiv: address, opening hours, email and a map. The ZX Spectrum section."
>
  <Header lang={lang} active="contacts" path={path} />
  <ContactsView lang={lang} />
  <Footer lang={lang} />
</BaseLayout>
