---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { Lang, UIKey } from '../i18n/ui';
import { useTranslations, localizePath } from '../i18n/ui';
import { normalizeModels } from '../lib/catalog';
import { getModelImage } from '../lib/images';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Обкладинка hero — реальний експонат ZX Spectrum 48K із каталогу (те саме
// фото й та сама атрибуція, що на /models/, — джерело істини одне). Якщо його
// колись приберуть — hero тихо деградує до рамки без зображення, не падаючи.
const models = normalizeModels(await getCollection('models'), lang);
const featured = models.find((m) => m.slug === 'zx-spectrum-48k') ?? null;
const heroImg = getModelImage(featured?.cover?.src ?? null);

// Плитки розділів (макет HomePage.dc.html). Колір смуги — BRIGHT як заливка
// (не текст, ТЗ §4.2). available: чи існує сторінка. Ще не збудовані НЕ ведуть
// у 404 — показуємо чесний стан «незабаром» замість посилання (HANDOFF §7.2).
const tiles: { key: string; href: string; color: string; available: boolean }[] = [
  { key: 'history', href: '/history/', color: '#ff0000', available: false },
  { key: 'models', href: '/models/', color: '#ffff00', available: true },
  { key: 'clones', href: '/clones/', color: '#00ff00', available: false },
  { key: 'exhibits', href: '/exhibits/', color: '#00ffff', available: false },
  { key: 'software', href: '/software/', color: '#ff00ff', available: false },
  { key: 'peripherals', href: '/peripherals/', color: '#ffffff', available: true },
  { key: 'contacts', href: '/contacts/', color: '#ffd700', available: false },
].map((x) => ({ ...x, href: localizePath(x.href, lang) }));

const tileLabel = (key: string) => t(`nav.${key}` as UIKey);
const tileDesc = (key: string) => t(`home.tile.${key}` as UIKey);
---

<main>
  <!-- HERO -->
  <section class="wrap hero">
    <div class="hero-copy">
      <p class="eyebrow">{t('home.eyebrow')}</p>
      <h1>ZX&nbsp;SPECTRUM</h1>
      <p class="lead">{t('home.hero.lead')}</p>
      <a class="cta" href={localizePath('/models/', lang)}>{t('home.hero.cta')} →</a>
    </div>

    {
      featured && (
        <div class="hero-media">
          <a class="frame" href={featured.href} aria-label={featured.title}>
            <span class="frame-bar" aria-hidden="true">
              <span style="background:#ff0000" /><span style="background:#ffff00" />
              <span style="background:#00ff00" /><span style="background:#00ffff" />
            </span>
            <div class="frame-img">
              {heroImg && featured.cover ? (
                <Image
                  src={heroImg}
                  alt={featured.cover.alt}
                  widths={[360, 720]}
                  sizes="(max-width: 900px) 100vw, 420px"
                  class="photo"
                />
              ) : (
                <span class="frame-q" aria-hidden="true">?</span>
              )}
            </div>
            <div class="frame-cap">
              <span class="frame-name">{featured.title}</span>
              <span class="frame-meta">{featured.year} · {featured.countryCode}</span>
            </div>
          </a>
          {featured.cover && <div class="frame-credit">{featured.cover.credit}</div>}
        </div>
      )
    }
  </section>

  <!-- INTRO -->
  <section class="wrap about">
    <div class="about-label">{t('home.about.label')}</div>
    <p class="about-body">{t('home.about.body')}</p>
  </section>

  <!-- SECTION TILES -->
  <section class="wrap tiles-sec">
    <h2 class="sec-title">{t('home.sections')}</h2>
    <div class="tiles">
      {
        tiles.map((tile) =>
          tile.available ? (
            <a class="tile" href={tile.href}>
              <span class="tile-bar" style={`background:${tile.color}`} aria-hidden="true" />
              <span class="tile-body">
                <span class="tile-title">{tileLabel(tile.key)}</span>
                <span class="tile-desc">{tileDesc(tile.key)}</span>
                <span class="tile-more">{t('home.more')}</span>
              </span>
            </a>
          ) : (
            <div class="tile soon" aria-disabled="true">
              <span class="tile-bar" style={`background:${tile.color}`} aria-hidden="true" />
              <span class="tile-body">
                <span class="tile-title">{tileLabel(tile.key)}</span>
                <span class="tile-desc">{tileDesc(tile.key)}</span>
                <span class="tile-soon">{t('home.soon')}</span>
              </span>
            </div>
          ),
        )
      }
    </div>
  </section>
</main>

<style>
  .wrap {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 28px;
    box-sizing: border-box;
  }

  /* --- HERO ---
     Одна колонка за замовчуванням. Дві — лише з 1200px, і копії дається БІЛЬШЕ
     місця, ніж зображенню. Причина — пастка HANDOFF §8: піксельний заголовок
     «ZX SPECTRUM» (nbsp, без переносу) — це ~610px тексту; у рівних колонках він
     не влазить аж до дуже широких вікон і малюється поза боксом, налазячи на
     фото (горизонтального скролу немає — текст не розширює бокс, тому діагноз
     лише через scrollWidth > clientWidth). Ширша копія-колонка дає йому місце. */
  .hero {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-top: 56px;
    padding-bottom: 40px;
  }
  .hero-copy { min-width: 0; }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--zx-cyan);
    margin: 0 0 18px;
  }
  h1 {
    font-family: var(--font-pixel);
    font-weight: 700;
    /* clamp із мінімумом 30px: нерозривний пробіл у ZX SPECTRUM не дає переносу,
       а на 320px (ТЗ §10) великий мінімум давав би горизонтальний скрол. */
    font-size: clamp(30px, 8vw, 66px);
    line-height: 0.92;
    color: var(--zx-white);
    text-transform: uppercase;
    letter-spacing: 0.01em;
    margin: 0;
  }
  .lead {
    font-size: 20px;
    line-height: 1.6;
    color: var(--text);
    max-width: 520px;
    margin: 22px 0 30px;
  }
  .cta {
    display: inline-block;
    font-family: var(--font-pixel);
    font-size: 16px;
    text-transform: uppercase;
    background: var(--zx-yellow);
    color: #000;
    padding: 14px 26px;
    text-decoration: none;
  }
  .cta:hover { background: var(--museum-gold); }

  .hero-media { width: 100%; max-width: 440px; }
  .frame {
    display: block;
    border: 2px solid var(--border);
    background: #060606;
    padding: 22px;
    position: relative;
    text-decoration: none;
    transition: border-color var(--dur) var(--ease-out);
  }
  .frame:hover { border-color: var(--zx-cyan); }
  .frame:focus-visible { outline: 2px solid var(--zx-cyan); outline-offset: 2px; }
  .frame-bar {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    height: 10px;
    width: 100%;
    z-index: 2;
  }
  .frame-bar > span { flex: 1; }
  .frame-img {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    margin-top: 8px;
    background: radial-gradient(
      ellipse at 50% 55%,
      rgba(0, 255, 255, 0.07),
      transparent 68%
    );
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .photo {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .frame-q {
    font-family: var(--font-pixel);
    font-size: 40px;
    color: var(--zx-magenta);
  }
  .frame-cap {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
    margin-top: 14px;
  }
  .frame-name {
    font-family: var(--font-pixel);
    font-size: 15px;
    color: var(--text);
    text-transform: uppercase;
  }
  .frame-meta {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--dim-6);
    flex: none;
  }
  .frame-credit {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--dim-6);
    margin-top: 8px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* --- INTRO --- */
  .about {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    border-top: 1px solid var(--hair);
    padding-top: 36px;
    margin-top: 4px;
  }
  .about-label {
    flex: 0 0 auto;
    width: 220px;
    min-width: 180px;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 12px;
    color: var(--text-dim);
  }
  .about-body {
    flex: 1 1 380px;
    margin: 0;
    font-size: 19px;
    line-height: 1.65;
    color: var(--text);
    max-width: 680px;
  }

  /* --- TILES --- */
  .tiles-sec { padding-top: 44px; padding-bottom: 48px; }
  .sec-title {
    font-family: var(--font-pixel);
    font-weight: 700;
    font-size: 26px;
    color: var(--zx-white);
    text-transform: uppercase;
    margin: 0 0 22px;
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 16px;
  }
  .tile {
    display: block;
    border: 2px solid var(--border);
    background: var(--surface);
    text-decoration: none;
    transition: border-color var(--dur) var(--ease-out);
  }
  a.tile:hover { border-color: var(--zx-cyan); }
  a.tile:focus-visible { outline: 2px solid var(--zx-cyan); outline-offset: 2px; }
  /* «Незабаром»: тьмяніша, некликабельна, з чесним підписом замість «Детальніше».
     Це не помилка й не порожнеча — сторінка існуватиме, просто ще не збудована. */
  .tile.soon { opacity: 0.62; cursor: default; }
  .tile-bar { display: block; height: 5px; }
  .tile-body { display: block; padding: 20px 18px 22px; }
  .tile-title {
    display: block;
    font-family: var(--font-pixel);
    font-weight: 600;
    font-size: 21px;
    color: var(--zx-white);
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .tile-desc {
    display: block;
    font-size: 15px;
    color: var(--text-dim);
    line-height: 1.5;
    margin-bottom: 16px;
  }
  .tile-more,
  .tile-soon {
    display: block;
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .tile-more { color: var(--zx-yellow); }
  .tile-soon { color: var(--dim-6); }

  /* Дві колонки лише коли копії вистачає місця на заголовок (§8): при 1200px
     content ≈ 1124px, копія ≈ 668px > 610px тексту. Збігається з брейкпоінтом
     шапки (бургер < 1280px — «десктоп/мобайл» без проміжного варіанта, §8). */
  @media (min-width: 1200px) {
    .hero {
      flex-direction: row;
      align-items: center;
      gap: 56px;
    }
    .hero-copy { flex: 1 1 auto; }
    .hero-media { flex: 0 0 400px; max-width: none; }
  }
  @media (max-width: 400px) {
    .wrap { padding: 0 16px; }
    .hero { padding-top: 40px; }
    .lead { font-size: 18px; }
    .about-body { font-size: 17px; }
  }
</style>
