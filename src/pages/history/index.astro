---
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HistoryView from '../../components/HistoryView.astro';

const lang: Lang = 'uk';
const path = '/history/';
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  path={path}
  title={`${t('history.title')} · ZX Spectrum — SnC Museum`}
  description="Історія ZX Spectrum, 1980–1992: від задуму Клайва Сінклера до кінця епохи 8-бітних машин. Таймлайн ключових моделей і подій. Освітній проєкт SnC Museum."
>
  <Header lang={lang} active="history" path={path} />
  <HistoryView lang={lang} />
  <Footer lang={lang} />
</BaseLayout>
