---
import type { Lang } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HomeView from '../../components/HomeView.astro';

const lang: Lang = 'en';
const path = '/';
---

<BaseLayout
  lang={lang}
  path={path}
  home
  title="ZX Spectrum — SnC Museum"
  description="The Software and Computer Museum’s educational section on the ZX Spectrum: history, models, clones, software and peripherals. Every fact is reviewed and approved by the museum."
>
  <Header lang={lang} active="" path={path} />
  <HomeView lang={lang} />
  <Footer lang={lang} />
</BaseLayout>
