---
import type { Lang } from '../i18n/ui';
import { useTranslations, localizePath } from '../i18n/ui';
import RainbowBar from './RainbowBar.astro';

interface Props {
  lang: Lang;
  /** Активний пункт меню (ключ nav.* без префікса), напр. "models". */
  active?: string;
  /** Поточний шлях без мовного префікса (для перемикача мов). */
  path: string;
}

const { lang, active = '', path } = Astro.props;
const t = useTranslations(lang);

const items = [
  { key: 'history', href: '/history/' },
  { key: 'models', href: '/models/' },
  { key: 'clones', href: '/clones/' },
  { key: 'software', href: '/software/' },
  { key: 'peripherals', href: '/peripherals/' },
  { key: 'contacts', href: '/contacts/' },
].map((i) => ({
  ...i,
  label: t(`nav.${i.key}` as Parameters<typeof t>[0]),
  url: localizePath(i.href, lang),
  on: i.key === active,
}));

const home = localizePath('/', lang);
const uaHref = localizePath(path, 'uk');
const enHref = localizePath(path, 'en');
---

<header class="site-header">
  <div class="hd-inner">
    <a class="wordmark" href={home}>ZX&nbsp;SPECTRUM</a>

    <nav class="hd-nav" aria-label={t('nav.models')}>
      {
        items.map((i) => (
          <a
            class:list={['hd-link', { on: i.on }]}
            href={i.url}
            aria-current={i.on ? 'page' : undefined}
          >
            {i.label}
            {i.on && <span class="hd-underline" aria-hidden="true" />}
          </a>
        ))
      }
    </nav>

    <div class="hd-tools">
      <a class="search-link" href={localizePath('/search/', lang)} aria-label={t('search.open')}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"></circle>
          <line x1="16.5" y1="16.5" x2="21" y2="21" stroke="currentColor" stroke-width="2"></line>
        </svg>
      </a>

      <div class="lang-switch" role="group" aria-label="UA / EN">
        <a href={uaHref} class:list={['lang', { on: lang === 'uk' }]}>UA</a>
        <a href={enHref} class:list={['lang', { on: lang === 'en' }]}>EN</a>
      </div>

      <button
        type="button"
        id="crt-toggle"
        class="crt-toggle"
        aria-pressed="false"
        data-on={t('crt.on')}
        data-off={t('crt.off')}
      >
        <span class="crt-knob" aria-hidden="true"><span class="crt-dot"></span></span>
        <span class="crt-label">{t('crt.off')}</span>
      </button>

      <a class="to-museum" href="https://sncmuseum.org">{t('nav.toMuseum')}</a>

      <button
        type="button"
        id="menu-toggle"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={t('nav.models')}
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Мобільне випадне меню -->
  <nav class="mobile-nav" id="mobile-nav" hidden>
    {items.map((i) => <a href={i.url} class:list={['m-link', { on: i.on }]}>{i.label}</a>)}
    <a class="m-link" href={localizePath('/search/', lang)}>{t('search.open')}</a>
    <a class="m-link to-museum-m" href="https://sncmuseum.org">{t('nav.toMuseum')}</a>

    {/*
      ТЗ §5.1 вимагає UA/EN у шапці. На ≤768px .lang-switch у рядку шапки
      ховається (немає місця), тож без цієї копії з телефона мову перемкнути
      було б неможливо взагалі. Показується лише там, де верхній сховано.
    */}
    <div class="lang-switch m-lang" role="group" aria-label="UA / EN">
      <a href={uaHref} class:list={['lang', { on: lang === 'uk' }]}>UA</a>
      <a href={enHref} class:list={['lang', { on: lang === 'en' }]}>EN</a>
    </div>
  </nav>

  <RainbowBar height={6} />
</header>

<style>
  .site-header {
    background: var(--bg);
    position: relative;
    z-index: 20;
  }
  .hd-inner {
    display: flex;
    align-items: center;
    gap: 26px;
    padding: 16px 32px;
    max-width: 1440px;
    margin: 0 auto;
  }
  .wordmark {
    font-family: var(--font-pixel);
    font-size: 26px;
    color: var(--zx-white);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    text-decoration: none;
    flex: none;
  }

  .hd-nav {
    display: flex;
    gap: 22px;
    margin-left: 6px;
  }
  .hd-link {
    position: relative;
    font-family: var(--font-mono);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--text-dim);
    text-decoration: none;
    padding-bottom: 7px;
    white-space: nowrap;
    transition: color var(--dur) var(--ease-out);
  }
  .hd-link:hover { color: var(--zx-white); }
  .hd-link.on { color: var(--zx-white); }
  .hd-underline {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: linear-gradient(90deg, #ff0000, #ffff00, #00ff00, #00ffff);
  }

  .hd-tools {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 16px;
    flex: none;
  }
  .search-link {
    display: inline-flex;
    align-items: center;
    color: var(--text-dim);
    text-decoration: none;
    transition: color var(--dur) var(--ease-out);
  }
  .search-link:hover { color: var(--zx-cyan); }
  .search-link:focus-visible {
    outline: 2px solid var(--zx-cyan);
    outline-offset: 3px;
  }

  .lang-switch {
    display: flex;
    border: 1px solid var(--border-2);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .lang-switch .lang {
    padding: 5px 9px;
    color: var(--text-dim);
    text-decoration: none;
  }
  .lang-switch .lang.on {
    background: var(--zx-yellow);
    color: #000;
  }

  .crt-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--dim-6);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }
  .crt-knob {
    position: relative;
    width: 30px;
    height: 16px;
    border: 1px solid var(--border-2);
    display: inline-block;
    background: var(--surface);
  }
  .crt-dot {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 10px;
    height: 10px;
    background: #555;
    transition: left var(--dur) var(--ease-out);
  }
  :global(html.crt) .crt-toggle { color: var(--zx-cyan); }
  :global(html.crt) .crt-dot { left: 16px; background: var(--zx-green); }

  .to-museum {
    font-family: var(--font-mono);
    font-size: 12px;
    background: var(--museum-navy);
    color: var(--museum-gold);
    border: 2px solid var(--museum-gold);
    padding: 7px 12px;
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--dur) var(--ease-out);
  }
  .to-museum:hover { background: #1d3872; }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    width: 26px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }
  .menu-toggle span {
    height: 3px;
    width: 100%;
  }
  .menu-toggle span:nth-child(1) { background: var(--zx-red); }
  .menu-toggle span:nth-child(2) { background: var(--zx-yellow); }
  .menu-toggle span:nth-child(3) { background: var(--zx-green); }

  .mobile-nav {
    display: none;
    flex-direction: column;
    padding: 8px 18px 18px;
    gap: 2px;
    border-top: 1px solid var(--hair);
  }
  .mobile-nav[hidden] { display: none; }
  .m-link {
    font-family: var(--font-mono);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-dim);
    text-decoration: none;
    padding: 12px 4px;
    border-bottom: 1px solid var(--hair);
  }
  .m-link.on { color: var(--zx-white); }
  .to-museum-m {
    color: var(--museum-gold);
    border-bottom: none;
    margin-top: 6px;
  }
  /* Вмикається лише в медіазапиті 768px, де верхній .lang-switch сховано. */
  .m-lang {
    display: none;
    align-self: flex-start;
    margin-top: 12px;
  }
  .m-lang .lang { padding: 8px 14px; }

  /* --- Бургер замість горизонтального меню (< 1280px) ---
     Дизайн визначає рівно два варіанти шапки: desktop 1280 і mobile 390 —
     проміжного немає. Виміряно, що повне меню з 7 пунктів + інструменти
     потребує ~1216px контенту (EN довша за UA: «Peripherals»/«Specifications»),
     тобто мінімум 1280px вікна. Нижче — воно не влазило й давало горизонтальний
     скрол у всьому діапазоні планшетів (ТЗ §10 вимагає 320–1920).
     Тому межа тут 1279, а не 768: 768 було вгадано, 1280 — виміряно. */
  @media (max-width: 1279px) {
    .hd-nav { display: none; }
    .menu-toggle { display: flex; }
    .mobile-nav.open { display: flex; }
  }

  /* --- Компактна шапка (ТЗ: 768px) --- */
  @media (max-width: 768px) {
    .hd-inner { padding: 14px 18px; gap: 14px; }
    .wordmark { font-size: 19px; }
    /* Перемикач мов і «до музею» переїжджають у випадне меню (нижче) —
       у рядку шапки на телефоні для них немає місця. */
    .lang-switch,
    .to-museum { display: none; }
    /* Дизайн мобільної шапки (Header.dc.html, variant=mobile): напис · підпис
       CRT · бургер. Тумблер там не малюється — ховаємо й ми, це ще й ~38px,
       яких бракує на 320px. Підпис лишається: він і кнопка, і її accname. */
    .crt-knob { display: none; }
    .m-lang { display: flex; }
  }

  /* --- нижня межа ТЗ §10 (320px) --- */
  @media (max-width: 400px) {
    .hd-inner { padding: 14px 14px; gap: 10px; }
    /* Піксельний шрифт не переноситься всередині слова, а .wordmark має
       flex:none — на 320px він виштовхував шапку в горизонтальний скрол. */
    .wordmark { font-size: 16px; }
    .hd-tools { gap: 12px; }
  }
</style>

<script>
  // CRT-перемикач: стан у localStorage, клас на <html>, оновлення підпису/кнопки.
  function syncCrt() {
    const on = document.documentElement.classList.contains('crt');
    const btn = document.getElementById('crt-toggle');
    if (!btn) return;
    btn.setAttribute('aria-pressed', String(on));
    const label = btn.querySelector('.crt-label');
    if (label) label.textContent = on ? btn.dataset.on! : btn.dataset.off!;
  }
  const crtBtn = document.getElementById('crt-toggle');
  crtBtn?.addEventListener('click', () => {
    const on = document.documentElement.classList.toggle('crt');
    try {
      localStorage.setItem('zx-crt', on ? 'on' : 'off');
    } catch (e) {}
    syncCrt();
  });
  syncCrt();

  // Мобільне меню (бургер).
  const menuBtn = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  menuBtn?.addEventListener('click', () => {
    const open = mobileNav?.classList.toggle('open');
    if (mobileNav) mobileNav.hidden = !open;
    menuBtn.setAttribute('aria-expanded', String(!!open));
  });
</script>
