---
import { getCollection, render } from 'astro:content';
import type { Lang } from '../../i18n/ui';
import { entryLang, entrySlug, isPublished, normalizeLongread } from '../../lib/longreads';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import LongreadDetail from '../../components/LongreadDetail.astro';

const lang: Lang = 'uk';

// Лонгрід (ТЗ §5 /history/{slug}/). На сайт виходять лише затверджені матеріали
// з датою публікації (isPublished) — чернетки лишаються поза збіркою. EN-версія —
// окремий маршрут /en/history/{slug}/; коли перекладу ще немає, hreflang робимо
// реципрокним (singleLang), щоб не рекламувати неіснуючу сторінку.
export async function getStaticPaths() {
  const published = (await getCollection('longreads')).filter(isPublished);
  const enSlugs = new Set(
    published.filter((e) => entryLang(e) === 'en').map(entrySlug),
  );
  return published
    .filter((e) => entryLang(e) === 'uk')
    .map((entry) => ({
      params: { slug: entrySlug(entry) },
      props: { entry, hasTranslation: enSlugs.has(entrySlug(entry)) },
    }));
}

const { entry, hasTranslation } = Astro.props;
const { Content } = await render(entry);
const article = normalizeLongread(entry);
const path = `/history/${article.slug}/`;
---

<BaseLayout
  lang={lang}
  path={path}
  title={`${article.title} · Історія · ZX Spectrum — SnC Museum`}
  description={article.description}
  singleLang={!hasTranslation}
>
  <Header lang={lang} active="history" path={path} />
  <LongreadDetail article={article} lang={lang}>
    <Content />
  </LongreadDetail>
  <Footer lang={lang} />
</BaseLayout>
