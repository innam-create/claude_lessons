---
import type { Lang } from '../i18n/ui';
import { useTranslations, localizePath } from '../i18n/ui';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const homeHref = localizePath('/', lang);

// Таймлайн 1980–1992 — реальні, добре задокументовані віхи Sinclair/Spectrum.
// Дані провізорні до додавання джерел (ТЗ §12): публікацію гейтить музей.
// Тримаємо тут (а не в i18n): це контент розділу, а не UI-хром.
const timeline: { year: string; event: Record<Lang, string> }[] = [
  {
    year: '1980',
    event: {
      uk: 'ZX80 — перший масовий домашній комп’ютер компанії.',
      en: 'The ZX80 — the company’s first mass-market home computer.',
    },
  },
  {
    year: '1981',
    event: {
      uk: 'ZX81 закріплює успіх: дешевий і доступний.',
      en: 'The ZX81 cements the success: cheap and accessible.',
    },
  },
  {
    year: '1982',
    event: {
      uk: 'Виходить ZX Spectrum: колір, звук, легенда.',
      en: 'The ZX Spectrum arrives: colour, sound, a legend.',
    },
  },
  {
    year: '1984',
    event: {
      uk: 'ZX Spectrum+ зі «справжньою» клавіатурою.',
      en: 'The ZX Spectrum+ with a “proper” keyboard.',
    },
  },
  {
    year: '1985',
    event: {
      uk: 'ZX Spectrum 128: більше пам’яті та звуковий чип.',
      en: 'The ZX Spectrum 128: more memory and a sound chip.',
    },
  },
  {
    year: '1986',
    event: {
      uk: 'Amstrad купує права; виходить +2 із вбудованим касетником.',
      en: 'Amstrad buys the rights; the +2 ships with a built-in cassette deck.',
    },
  },
  {
    year: '1992',
    event: {
      uk: 'Виробництво Spectrum згортається — кінець епохи.',
      en: 'Spectrum production winds down — the end of an era.',
    },
  },
];
---

<main data-pagefind-body>
  <div class="wrap head">
    <Breadcrumbs
      items={[{ label: t('nav.home'), href: homeHref }, { label: t('history.title') }]}
    />
    <h1>{t('history.title')}</h1>
    <p class="intro">{t('history.intro')}</p>
  </div>

  <!-- ТАЙМЛАЙН -->
  <section class="wrap tl-sec" aria-label={t('history.range')}>
    <div class="tl-range">{t('history.range')}</div>
    <ol class="timeline">
      {
        timeline.map((it) => (
          <li class="tl-item">
            <div class="tl-node-row">
              <span class="tl-node" aria-hidden="true" />
              <span class="tl-line" aria-hidden="true" />
            </div>
            <div class="tl-year">{it.year}</div>
            <div class="tl-event">{it.event[lang]}</div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- СТАТТІ — чесний порожній стан (лонгрідів ще немає) -->
  <section class="wrap art-sec">
    <h2>{t('history.articles')}</h2>
    <div class="art-empty">
      <span class="art-dots" aria-hidden="true">
        <span style="background:#ff0000" /><span style="background:#ffff00" />
        <span style="background:#00ff00" /><span style="background:#00ffff" />
      </span>
      <p>{t('history.articles.empty')}</p>
    </div>
  </section>
</main>

<style>
  .wrap {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 28px;
    box-sizing: border-box;
  }
  .head { padding-top: 8px; }
  h1 {
    font-family: var(--font-pixel);
    font-weight: 700;
    font-size: 44px;
    color: var(--zx-white);
    text-transform: uppercase;
    margin: 20px 0 0;
    line-height: 1;
  }
  .intro {
    font-size: 19px;
    line-height: 1.65;
    color: var(--text);
    max-width: 720px;
    margin: 18px 0 22px;
    border-bottom: 1px solid var(--hair);
    padding-bottom: 22px;
  }

  /* --- таймлайн --- */
  .tl-sec { padding-top: 20px; padding-bottom: 20px; }
  .tl-range {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--text-dim);
    margin-bottom: 22px;
  }

  /* Мобільно-first: вертикальний список із лівим рейлом і вузлами. */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tl-item {
    position: relative;
    padding: 0 0 26px 26px;
    border-left: 3px solid var(--border);
  }
  .tl-item:last-child { border-left-color: transparent; }
  .tl-node-row {
    position: absolute;
    left: -9px;
    top: 0;
  }
  .tl-node {
    display: block;
    width: 15px;
    height: 15px;
    box-sizing: border-box;
    background: var(--bg);
    border: 3px solid var(--zx-white);
  }
  .tl-line { display: none; }
  .tl-year {
    font-family: var(--font-pixel);
    font-size: 22px;
    color: var(--zx-cyan);
    text-transform: uppercase;
    margin: -4px 0 6px;
  }
  .tl-event {
    font-size: 15px;
    color: var(--text);
    line-height: 1.5;
  }

  /* Десктоп: горизонтальний ряд із 7 колонок і кольоровими зʼєднувачами.
     1080px, а не менше: 7 колонок нижче стають надто вузькими для підписів. */
  @media (min-width: 1080px) {
    .timeline {
      display: grid;
      grid-template-columns: repeat(7, minmax(0, 1fr));
      gap: 0;
    }
    .tl-item {
      position: static;
      padding: 0 14px 0 0;
      border-left: none;
    }
    .tl-node-row {
      position: static;
      display: flex;
      align-items: center;
    }
    .tl-line {
      display: block;
      flex: 1;
      height: 3px;
      background: linear-gradient(90deg, #ff0000, #ffff00, #00ff00, #00ffff);
    }
    .tl-item:last-child .tl-line { background: transparent; }
    .tl-year { margin: 12px 0 6px; }
  }

  /* --- статті: порожній стан --- */
  .art-sec { padding-top: 26px; padding-bottom: 60px; }
  h2 {
    font-family: var(--font-pixel);
    font-weight: 700;
    font-size: 26px;
    color: var(--zx-white);
    text-transform: uppercase;
    margin: 0 0 20px;
  }
  .art-empty {
    border: 2px dashed var(--border);
    padding: 32px 28px;
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }
  .art-dots {
    display: inline-grid;
    grid-template-columns: repeat(2, 12px);
    gap: 4px;
    flex: none;
  }
  .art-dots > span { width: 12px; height: 12px; }
  .art-empty p {
    margin: 0;
    font-size: 16px;
    color: var(--text-dim);
    line-height: 1.6;
    max-width: 640px;
  }

  @media (max-width: 400px) {
    .wrap { padding: 0 16px; }
    h1 { font-size: 30px; }
    .intro { font-size: 17px; }
  }
</style>
