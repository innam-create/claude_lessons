---
import '../styles/theme.css';
// Self-host шрифтів (§8): раніше вантажилися з fonts.googleapis.com — зайвий
// сторонній домен, трекінг і затримка на з'єднанні. Тепер локально через
// @fontsource (Astro хешує й кладе woff2 у dist). Родини лишаються ті самі
// ('Golos Text' / 'IBM Plex Mono' / 'Handjet'), тож theme.css не змінюється.
// Ваги — лише реально вживані в коді (400/600/700); Google-запит тягнув зайві.
// @fontsource ставить font-display:swap — поведінка як була з display=swap.
import '@fontsource/golos-text/400.css'; // body
import '@fontsource/golos-text/600.css';
import '@fontsource/golos-text/700.css';
import '@fontsource/ibm-plex-mono/400.css'; // метадані/роки
import '@fontsource/ibm-plex-mono/600.css';
import '@fontsource/ibm-plex-mono/700.css';
// Handjet — фолбек піксельного Retroville. Тягнемо лише потрібні підмножини
// (latin/cyrillic + ext), бо агрегат містить ще arabic/armenian/greek/hebrew.
import '@fontsource/handjet/latin-400.css';
import '@fontsource/handjet/latin-ext-400.css';
import '@fontsource/handjet/cyrillic-400.css';
import '@fontsource/handjet/cyrillic-ext-400.css';
import '@fontsource/handjet/latin-700.css';
import '@fontsource/handjet/latin-ext-700.css';
import '@fontsource/handjet/cyrillic-700.css';
import '@fontsource/handjet/cyrillic-ext-700.css';
import type { Lang } from '../i18n/ui';
import { localizePath } from '../i18n/ui';
import { museumSchema, webSiteSchema, serializeJsonLd } from '../lib/schema';

interface Props {
  title: string;
  description?: string;
  lang: Lang;
  /** Шлях сторінки без мовного префікса, напр. "/models/". Для hreflang. */
  path: string;
  /** OG-зображення сторінки (абсолютний URL). Не задано → бренд-дефолт /og.png. */
  ogImage?: string;
  /** true лише на головній кожної мови: додає WebSite + SearchAction (ТЗ §9). */
  home?: boolean;
}

const { title, description, lang, path, ogImage, home } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';

// Structured data (ТЗ §9): Museum — site-wide (видавець), WebSite+SearchAction —
// лише на головній. BreadcrumbList емітують самі Breadcrumbs.astro на кожній
// внутрішній сторінці. Усі значення виводяться з уже показаних верифікованих даних.
const jsonLd: unknown[] = [museumSchema({ site, lang })];
if (home) jsonLd.push(webSiteSchema({ site, lang }));

// Canonical і og:url — абсолютний URL цієї сторінки саме цією мовою.
const canonical = `${site}${localizePath(path, lang)}`;
// Бренд-дефолт OG-зображення (public/og.png, 1200×630) — на весь сайт; сторінка
// може перекрити пропом. Абсолютний URL обовʼязковий для og:image (ТЗ §9).
const ogImageUrl = ogImage ?? `${site}/og.png`;
// ТЗ §9: OG-локаль у форматі ll_CC; alternate — інша мова сайту.
const ogLocale = lang === 'uk' ? 'uk_UA' : 'en_GB';
const ogAltLocale = lang === 'uk' ? 'en_GB' : 'uk_UA';
---

<!doctype html>
<html lang={lang === 'uk' ? 'uk' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />

    <!-- Open Graph (ТЗ §9): превʼю в месенджерах і соцмережах -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Software & Computer Museum" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogAltLocale} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ZX SPECTRUM — Software & Computer Museum" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- hreflang для UA/EN (ТЗ §9) -->
    <link rel="alternate" hreflang="uk" href={`${site}${localizePath(path, 'uk')}`} />
    <link rel="alternate" hreflang="en" href={`${site}${localizePath(path, 'en')}`} />
    <link rel="alternate" hreflang="x-default" href={`${site}${localizePath(path, 'uk')}`} />

    <!-- Structured data / JSON-LD (ТЗ §9): Museum + (на головній) WebSite -->
    {jsonLd.map((node) => (
      <script type="application/ld+json" set:html={serializeJsonLd(node)} is:inline />
    ))}

    <!-- Шрифти self-host через @fontsource — імпорти у frontmatter (див. вгорі). -->

    <!-- CRT-режим: застосувати збережений стан ДО першого малювання (без спалаху). -->
    <script is:inline>
      try {
        if (localStorage.getItem('zx-crt') === 'on') {
          document.documentElement.classList.add('crt');
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
    <div class="crt-overlay" aria-hidden="true"></div>
  </body>
</html>
