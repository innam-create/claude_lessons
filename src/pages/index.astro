---
import type { Lang } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HomeView from '../components/HomeView.astro';

const lang: Lang = 'uk';
const path = '/';
---

<BaseLayout
  lang={lang}
  path={path}
  home
  title="ZX Spectrum — SnC Museum"
  description="Освітній розділ Software and Computer Museum про ZX Spectrum: історія, моделі, клони, софт і периферія. Кожен факт — після перевірки й затвердження музеєм."
>
  <Header lang={lang} active="" path={path} />
  <HomeView lang={lang} />
  <Footer lang={lang} />
</BaseLayout>
