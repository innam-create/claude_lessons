---
// ТЗ §5.1: хлібні крихти на всіх внутрішніх сторінках.
// Останній елемент — поточна сторінка, без посилання.
import { breadcrumbSchema, serializeJsonLd, type Crumb } from '../lib/schema';

interface Props {
  items: Crumb[];
}
const { items } = Astro.props;

// BreadcrumbList JSON-LD (ТЗ §9) з тих самих items — тож кожна сторінка з
// крихтами отримує його автоматично, без окремого коду на сторінці.
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const breadcrumbLd = serializeJsonLd(breadcrumbSchema(site, items, Astro.url.href));
---

<script type="application/ld+json" set:html={breadcrumbLd} is:inline />

<nav class="crumbs" aria-label="breadcrumbs">
  {
    items.map((item, i) => (
      <>
        {i > 0 && (
          <span class="sep" aria-hidden="true">
            /
          </span>
        )}
        {item.href ? (
          <a href={item.href}>{item.label}</a>
        ) : (
          <span class="here" aria-current="page">
            {item.label}
          </span>
        )}
      </>
    ))
  }
</nav>

<style>
  .crumbs {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-dim);
    padding: 20px 0 4px;
    letter-spacing: 0.04em;
  }
  .crumbs a {
    color: var(--text-dim);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--zx-cyan);
  }
  .crumbs .sep {
    color: var(--dim-4);
    margin: 0 8px;
  }
  .crumbs .here {
    color: var(--zx-cyan);
  }
</style>
