---
import { Image } from 'astro:assets';
import type { Model } from '../lib/catalog';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import { getModelImage } from '../lib/images';

interface Props {
  model: Model;
  lang: Lang;
}
const { model, lang } = Astro.props;
const t = useTranslations(lang);

const cover = model.cover;
const img = getModelImage(cover?.src ?? null);
const hasImage = !!img && !!cover;
---

{/*
  Картка — <div>, а не <a>, хоча клікабельна вся: всередині є кнопка «порівняти»,
  а інтерактивні елементи не можна вкладати в <a> (невалідно, Astro 7 впаде — R6).
  Замість обгортки використано «розтягнуте посилання»: .name-link::after накриває
  картку. Побічно це краще для доступності — назвою посилання стає заголовок
  моделі, а не весь текст картки, як було раніше.
*/}
<div
  class="card"
  data-card
  data-slug={model.slug}
  data-year={model.year}
  data-maker={model.maker}
  data-country={model.countryCode}
  data-ram={model.ram}
  data-museum={String(model.inMuseum)}
>
  {
    hasImage ? (
      <>
        <div class="media">
          <Image
            src={img!}
            alt={cover!.alt}
            widths={[340, 680]}
            sizes="(max-width: 768px) 100vw, 380px"
            class="photo"
          />
          <span class="corner" aria-hidden="true">
            <span style="background:#ff0000" /><span style="background:#ffff00" />
            <span style="background:#00ff00" /><span style="background:#00ffff" />
          </span>
        </div>
        {/*
          ТЗ §7.3 вимагає в рядку атрибуції посилання на текст ліцензії. Тут його
          немає навмисно: картка — це <a>, а вкладені <a> невалідні (Astro 7 на
          цьому впаде, ТЗ §3/R6). Рядок лишається повним і читабельним, а клікабельні
          «ліцензія» й «джерело» живуть у галереї на /models/{slug}/, де обгортки-<a> немає.
        */}
        <div class="credit" title={cover!.credit}>{cover!.credit}</div>
      </>
    ) : (
      <div class="noimg">
        <div class="q">?</div>
        <div class="seek" set:html={t('card.seeking')} />
        <div class="mail">contact@sncmuseum.org</div>
      </div>
    )
  }

  <div class="body">
    <div class="row">
      <div class="badges">
        {model.inMuseum && <span class="badge museum">{t('card.inMuseum')}</span>}
        {model.lowConf && <span class="badge low">{t('card.unverified')}</span>}
      </div>
      <span class="year">{model.year}</span>
    </div>
    <a class="name-link" href={model.href}><span class="name">{model.title}</span></a>
    <div class="country">{model.countryLabel}</div>
    <p class="desc">{model.desc}</p>

    <button
      type="button"
      class="cmp-add"
      data-cmp-add
      aria-pressed="false"
      data-pick={t('compare.pick')}
      data-picked={t('compare.picked')}
    >
      {t('compare.pick')}
    </button>
  </div>
</div>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 2px solid var(--border);
    background: var(--surface);
    height: 100%;
    box-sizing: border-box;
    transition: border-color var(--dur) var(--ease-out);
  }
  .card:hover { border-color: var(--zx-cyan); }
  /* Картка в порівнянні — маджента, як панель компаратора. Колір не єдиний
     носій сенсу (ТЗ §4.2): підпис кнопки теж змінюється на «✓ у порівнянні». */
  .card.picked { border-color: var(--zx-magenta); }

  .media {
    aspect-ratio: 4 / 3;
    position: relative;
    overflow: hidden;
    background: var(--surface-2);
  }
  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .corner {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    height: 8px;
    width: 64px;
    z-index: 2;
  }
  .corner > span { flex: 1; }

  .credit {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--dim-6);
    padding: 6px 12px;
    border-bottom: 1px solid var(--hair);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .noimg {
    aspect-ratio: 4 / 3;
    background: var(--surface-2);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px;
    text-align: center;
    border-bottom: 1px solid var(--hair);
  }
  .noimg .q {
    font-family: var(--font-pixel);
    font-size: 30px;
    color: var(--zx-magenta);
  }
  .noimg .seek {
    font-size: 14px;
    color: var(--text-dim);
    line-height: 1.4;
  }
  .noimg .mail {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--zx-cyan);
  }

  .body {
    padding: 14px 16px 18px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    min-height: 24px;
  }
  .badges { display: flex; gap: 6px; }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
  }
  .badge.museum {
    background: var(--museum-gold);
    color: var(--museum-navy);
    padding: 4px 9px;
  }
  .badge.low {
    color: var(--zx-yellow);
    border: 1px dashed var(--zx-yellow);
    padding: 3px 7px;
  }
  .year {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--zx-cyan);
    flex: none;
  }
  /* Розтягнуте посилання: ::after накриває всю картку, тож клікабельна вона вся,
     а назвою посилання лишається сам заголовок. Кнопка «порівняти» піднята над
     цим шаром через z-index, інакше клік по ній вів би на сторінку моделі. */
  .name-link {
    text-decoration: none;
    display: block;
    margin: 12px 0 6px;
  }
  .name-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .name-link:focus-visible {
    outline: 2px solid var(--zx-blue);
    outline-offset: 2px;
  }
  .name {
    font-family: var(--font-pixel);
    font-weight: 600;
    font-size: 20px;
    color: var(--zx-white);
    text-transform: uppercase;
    line-height: 1.15;
    display: block;
  }
  .country {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-dim);
    margin-bottom: 10px;
  }
  .desc {
    font-size: 15px;
    color: var(--text-dim);
    line-height: 1.5;
    margin: 0 0 14px;
  }

  .cmp-add {
    position: relative;
    z-index: 1; /* над ::after розтягнутого посилання */
    margin-top: auto; /* притискає кнопку до низу, вирівнюючи по сітці */
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 7px 11px;
    background: transparent;
    color: var(--text-dim);
    border: 1px solid var(--border-2);
    cursor: pointer;
    transition:
      border-color var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out);
  }
  .cmp-add:hover { color: var(--zx-white); border-color: var(--text-dim); }
  .cmp-add[aria-pressed='true'] {
    color: var(--zx-magenta);
    border-color: var(--zx-magenta);
    background: rgba(255, 0, 255, 0.08);
  }
  /* Ліміт у 3 моделі (ТЗ §5.2): решта кнопок гасне, але лишається зрозумілою. */
  .cmp-add:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
</style>
