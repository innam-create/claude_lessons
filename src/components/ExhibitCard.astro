---
import { Image } from 'astro:assets';
import type { Model } from '../lib/catalog';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import { getModelImage } from '../lib/images';

interface Props {
  model: Model;
  lang: Lang;
}
const { model, lang } = Astro.props;
const t = useTranslations(lang);

const cover = model.cover;
const img = getModelImage(cover?.src ?? null);
const hasImage = !!img && !!cover;
---

{/*
  Експонат — це модель із колекції (inMuseum). Уся картка — <a> на картку моделі;
  усередині немає інтерактиву (кнопки «порівняти» тут нема), тож вкладених <a>
  не виникає (Astro 7 / R6 — ок).
*/}
<a class="card" href={model.href}>
  {
    hasImage ? (
      <>
        <div class="media">
          <Image
            src={img!}
            alt={cover!.alt}
            widths={[340, 680]}
            sizes="(max-width: 768px) 100vw, 380px"
            class="photo"
          />
          <span class="corner" aria-hidden="true">
            <span style="background:#ff0000" /><span style="background:#ffff00" />
            <span style="background:#00ff00" /><span style="background:#00ffff" />
          </span>
        </div>
        <div class="credit" title={cover!.credit}>{cover!.credit}</div>
      </>
    ) : (
      <div class="noimg">
        <div class="q">?</div>
        <div class="seek" set:html={t('card.seeking')} />
        <div class="mail">contact@sncmuseum.org</div>
      </div>
    )
  }

  <div class="body">
    <div class="row">
      <span class="badge museum">{t('card.inMuseum')}</span>
      <span class="year">{model.year}</span>
    </div>
    <span class="name">{model.title}</span>
    <div class="country">{model.countryLabel}</div>
    <p class="desc">{model.desc}</p>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    border: 2px solid var(--border);
    background: var(--surface);
    height: 100%;
    box-sizing: border-box;
    text-decoration: none;
    transition: border-color var(--dur) var(--ease-out);
  }
  .card:hover { border-color: var(--zx-cyan); }
  .card:focus-visible { outline: 2px solid var(--zx-cyan); outline-offset: 2px; }

  .media {
    aspect-ratio: 4 / 3;
    position: relative;
    overflow: hidden;
    background: var(--surface-2);
  }
  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .corner {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    height: 8px;
    width: 64px;
    z-index: 2;
  }
  .corner > span { flex: 1; }

  .credit {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--dim-6);
    padding: 6px 12px;
    border-bottom: 1px solid var(--hair);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .noimg {
    aspect-ratio: 4 / 3;
    background: var(--surface-2);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px;
    text-align: center;
    border-bottom: 1px solid var(--hair);
  }
  .noimg .q {
    font-family: var(--font-pixel);
    font-size: 30px;
    color: var(--zx-magenta);
  }
  .noimg .seek {
    font-size: 14px;
    color: var(--text-dim);
    line-height: 1.4;
  }
  .noimg .mail {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--zx-cyan);
  }

  .body {
    padding: 14px 16px 18px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    min-height: 24px;
  }
  .badge.museum {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
    background: var(--museum-gold);
    color: var(--museum-navy);
    padding: 4px 9px;
  }
  .year {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--zx-cyan);
    flex: none;
  }
  .name {
    font-family: var(--font-pixel);
    font-weight: 600;
    font-size: 20px;
    color: var(--zx-white);
    text-transform: uppercase;
    line-height: 1.15;
    margin: 12px 0 6px;
  }
  .country {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-dim);
    margin-bottom: 10px;
  }
  .desc {
    font-size: 15px;
    color: var(--text-dim);
    line-height: 1.5;
    margin: 0;
  }
</style>
