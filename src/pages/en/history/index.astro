---
import { getCollection } from 'astro:content';
import type { Lang } from '../../../i18n/ui';
import { useTranslations } from '../../../i18n/ui';
import { entryLang, isPublished, normalizeLongread, sortLongreads } from '../../../lib/longreads';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import HistoryView from '../../../components/HistoryView.astro';

const lang: Lang = 'en';
const path = '/history/';
const t = useTranslations(lang);

const articles = (await getCollection('longreads'))
  .filter(isPublished)
  .filter((e) => entryLang(e) === lang)
  .map(normalizeLongread)
  .sort(sortLongreads);
---

<BaseLayout
  lang={lang}
  path={path}
  title={`${t('history.title')} · ZX Spectrum — SnC Museum`}
  description="A history of the ZX Spectrum, 1980–1992: from Clive Sinclair’s idea to the end of the 8-bit era. A timeline of the key models and events. An SnC Museum project."
>
  <Header lang={lang} active="history" path={path} />
  <HistoryView lang={lang} articles={articles} />
  <Footer lang={lang} />
</BaseLayout>
