dist/
.astro/

# dependencies
node_modules/

# logs & env
*.log
.env
.env.production
.DS_Store

# секрети / SSH-ключі — НІКОЛИ не комітити.
# Привід: помилковий `eval "$9ssh-agent -s)"` (замість `$(`) записав вивід
# ssh-agent у файли — приватний ключ опинився в теці репозиторію.
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ecdsa*
id_ed25519*
*_rsa
*_ed25519
.ssh/
# файли-артефакти від помилково набраного eval "$(ssh-agent -s)"
eval "*
