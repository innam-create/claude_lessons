---
import type { Lang } from '../../i18n/ui';
import { localizePath, useTranslations } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const lang: Lang = 'en';
const path = '/';
const t = useTranslations(lang);
---

<BaseLayout lang={lang} path={path} title="ZX Spectrum — SnC Museum">
  <Header lang={lang} active="" path={path} />
  <main class="home">
    <p class="eyebrow">Software &amp; Computer Museum · Kharkiv</p>
    <h1>ZX&nbsp;SPECTRUM</h1>
    <p class="lead">
      An educational section about the ZX Spectrum, the original Sinclair models
      and clones — history, catalogue, software and peripherals.
    </p>
    <a class="cta" href={localizePath('/models/', lang)}>{t('nav.models')} →</a>
  </main>
  <Footer lang={lang} />
</BaseLayout>

<style>
  .home {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 80px 28px 100px;
    text-align: center;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--zx-cyan);
    margin: 0 0 20px;
  }
  h1 {
    font-family: var(--font-pixel);
    font-size: clamp(48px, 9vw, 96px);
    color: var(--zx-white);
    text-transform: uppercase;
    margin: 0;
    line-height: 0.9;
  }
  .lead {
    font-size: 20px;
    color: var(--text-dim);
    line-height: 1.55;
    max-width: 560px;
    margin: 28px auto 36px;
  }
  .cta {
    display: inline-block;
    font-family: var(--font-pixel);
    font-size: 16px;
    text-transform: uppercase;
    background: var(--zx-yellow);
    color: #000;
    padding: 14px 26px;
    text-decoration: none;
  }
  .cta:hover { background: var(--museum-gold); }
</style>
